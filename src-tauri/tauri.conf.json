{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Michi",
  "version": "1.15.1",
  "identifier": "com.nihongo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Michi",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Tu camino para aprender idiomas",
    "longDescription": "Michi (道, «el camino») es una app de escritorio para aprender idiomas a tu ritmo: japonés con SRS de kanji, gramática, práctica de lectura/escucha/habla y seguimiento de progreso — con más idiomas en camino.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "./entitlements.plist"
    }
  }
}
